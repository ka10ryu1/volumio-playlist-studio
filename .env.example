# このファイルを .env にコピーして値を設定する（.env は Git 管理対象外）。
# 環境変数が既に設定されている場合は、そちらが優先される。

# TypeSafe Jev の API キー（https://console.typesafe.ai/keys で発行）。
# 未設定でも、タグ情報とルールベースの分類で GUI を利用できる。
TYPESAFE_API_KEY=

# 解析結果・評価・プレイリストを保存する SQLite とログの保存先（既定: ./data）
VPS_DATA_DIR=data

# Volumio の接続先（例: volumio.local）。実機クライアントは未実装のため、現在は表示のみに使う
VOLUMIO_HOST=
