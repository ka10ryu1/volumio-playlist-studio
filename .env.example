# このファイルを .env にコピーして値を設定する（setup.cmd が自動でコピーする。.env は Git 管理対象外）。
# 環境変数が既に設定されている場合は、そちらが優先される。値は引用符で囲まない。

# TypeSafe Jev の API キー（https://console.typesafe.ai/keys で発行）。
# 未設定でも、タグ情報とルールベースの分類で GUI を利用できる。設定・変更後はアプリを再起動する。
TYPESAFE_API_KEY=

# 解析結果・評価・プレイリストを保存する SQLite とログの保存先（既定: プロジェクト直下の data）
# 相対パスはプロジェクト直下からのパスとして扱う
VPS_DATA_DIR=

# 画面のポート番号（既定: 8501）
VPS_PORT=8501

# 自宅 Wi-Fi のスマホから開けるようにする（1 で有効。既定の 0 はこの PC からのみ接続できる）。
# 有効にすると全てのネットワークで待ち受け、PC 以外からの接続には PIN を求める。
# PC のブラウザの「スマホで開く」画面に QR コードと PIN が表示される。
# 自宅 Wi-Fi を Windows の「プライベート ネットワーク」にし、ファイアウォールは「プライベート」だけ許可すること。
VPS_LAN=0

# スマホから開く PC の IP アドレス（省略時は自動で取得する。VPN 接続中などで QR コードの IP が違うときに指定）
# VPS_LAN_ADDRESS=192.168.1.10

# Volumio の接続先（例: volumio.local）。実機クライアントは未実装のため、現在は表示のみに使う
VOLUMIO_HOST=
